{
  "name": "surpluslink",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Food Surplus Redistribution Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "start:server": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "test:server": "npm run test --workspace=server",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
