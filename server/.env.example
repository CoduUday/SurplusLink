# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Local example: mongodb://127.0.0.1:27017/surpluslink
# Atlas example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/surpluslink?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/SurplusLink

# Authentication Secrets (placeholders - do not put real secrets here)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Optional AI / External Service Keys (IBM watsonx.ai & Granite LLM)
# SurplusLink runs fully on its explainable heuristic engine without these credentials.
# Configure only when connecting live IBM Granite model instances:
# IBM_WATSONX_APIKEY=your_watsonx_api_key_here
# IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
# IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
# IBM_GRANITE_MODEL_ID=ibm/granite-13b-chat-v2
